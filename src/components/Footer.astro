---
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
  <div class="container py-8">
    <div class="md:flex md:justify-between md:items-center">
      <div class="mb-6 md:mb-0">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white">Kieffer ILBOUDO</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 max-w-md">
          Artificial Intelligence student passionate about applied technologies for environmental and social impact in Burkina Faso.
        </p>
      </div>
      
      <div class="flex flex-col space-y-4 md:flex-row md:space-y-0 md:space-x-6">
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Connect</h3>
          <SocialLinks className="mt-3 flex space-x-5" />
        </div>
        
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Navigation</h3>
          <ul class="mt-3 space-y-2">
            <li><a href="#about" class="text-sm text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">About</a></li>
            <li><a href="#projects" class="text-sm text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Projects</a></li>
            <li><a href="#skills" class="text-sm text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Skills</a></li>
            <li><a href="#contact" class="text-sm text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Contact</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
      <p class="text-xs text-gray-500 dark:text-gray-400 text-center">
        &copy; {new Date().getFullYear()} ILBOUDO Wendpingre-Nôoma Kieffer. All rights reserved.
      </p>
    </div>
  </div>
</footer>
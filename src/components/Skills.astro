---
const skills = [
  {
    category: "Programming",
    items: [
      { name: "Python", icon: "logos:python" },
      { name: "TensorFlow", icon: "logos:tensorflow" },
      { name: "Docker", icon: "logos:docker-icon" },
      { name: "AWS", icon: "logos:aws" },
      { name: "Git", icon: "logos:git-icon" }
    ]
  },
  {
    category: "AI & ML",
    items: [
      { name: "Machine Learning", icon: "carbon:machine-learning" },
      { name: "Deep Learning", icon: "carbon:neural" },
      { name: "NLP", icon: "carbon:text-mining" },
      { name: "Computer Vision", icon: "carbon:visual-recognition" },
      { name: "Data Science", icon: "carbon:data-vis-4" }
    ]
  },
  {
    category: "Tools & Platforms",
    items: [
      { name: "VS Code", icon: "vscode-icons:file-type-vscode" },
      { name: "Jupyter", icon: "logos:jupyter" },
      { name: "Firebase", icon: "logos:firebase" },
      { name: "FastAPI", icon: "simple-icons:fastapi" },
      { name: "Flutter", icon: "logos:flutter" }
    ]
  }
];
---

<section id="skills" class="section bg-[#0A0F1C] text-white py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">Technical Skills</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {skills.map(category => (
        <div class="bg-gray-800/30 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50">
          <h3 class="text-xl font-semibold mb-6 text-blue-400">{category.category}</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
            {category.items.map(skill => (
              <div class="flex flex-col items-center text-center group">
                <div class="w-12 h-12 flex items-center justify-center bg-gray-700/50 rounded-lg mb-3 group-hover:bg-blue-500/20 transition-colors">
                  <span class="iconify text-2xl" data-icon={skill.icon}></span>
                </div>
                <span class="text-sm text-gray-300 group-hover:text-blue-400 transition-colors">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-16">
      <h3 class="text-2xl font-bold mb-8 text-center">Languages</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <div class="bg-gray-800/30 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50">
          <div class="flex items-center gap-4">
            <span class="iconify text-2xl" data-icon="twemoji:flag-france"></span>
            <div>
              <h4 class="text-lg font-medium">French</h4>
              <p class="text-gray-400 text-sm">Native - Written & Spoken</p>
            </div>
          </div>
        </div>
        <div class="bg-gray-800/30 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50">
          <div class="flex items-center gap-4">
            <span class="iconify text-2xl" data-icon="twemoji:flag-united-kingdom"></span>
            <div>
              <h4 class="text-lg font-medium">English</h4>
              <p class="text-gray-400 text-sm">Professional - Written & Spoken</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://code.iconify.design/3/3.1.0/iconify.min.js" is:inline></script>
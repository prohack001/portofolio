---
interface Education {
  degree: string;
  institution: string;
  period: string;
  location: string;
}

const education: Education[] = [
  {
    degree: "Master's in Computer Engineering (AI & Data Science)",
    institution: "École Polytechnique de Ouagadougou",
    period: "2022 - Present",
    location: "Burkina Faso"
  },
  {
    degree: "Bachelor's in Electrical Systems Engineering",
    institution: "Institut Supérieur de Génie Electrique",
    period: "2018 - 2021",
    location: "Ouagadougou"
  }
];
---

<section id="about" class="section bg-[#0A0F1C] text-white">
  <div class="container">
    <h2 class="section-title text-center mb-12">About Me</h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div class="space-y-6">
        <div class="prose prose-lg dark:prose-invert">
          <p class="text-gray-300">
            I am an AI student at École Polytechnique de Ouagadougou, passionate about applying technology 
            to environmental challenges and sustainable development in Burkina Faso.
          </p>
          
          <p class="text-gray-300">
            My journey has led me to develop diverse skills from Python programming to mobile development 
            with Flutter, UX/UI design, and data analysis. I'm particularly interested in using AI to create 
            impactful solutions for Burkina Faso's development.
          </p>
          
          <p class="text-gray-300">
            One of my flagship projects, Smart-Apic, is an IoT-based beehive monitoring device using machine 
            learning to improve local beekeeping production. This project, incubated at Orange Digital Center, 
            reflects my vision of technology serving sustainable development.
          </p>
        </div>
      </div>
      
      <div class="space-y-8">
        <h3 class="text-2xl font-bold mb-6">Education</h3>
        <div class="space-y-6">
          {education.map(edu => (
            <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg p-6 border border-gray-700/50">
              <h4 class="text-xl font-medium text-white mb-2">{edu.degree}</h4>
              <p class="text-blue-400">{edu.institution}</p>
              <div class="flex items-center gap-4 mt-2 text-sm text-gray-400">
                <span>{edu.period}</span>
                <span>•</span>
                <span>{edu.location}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>